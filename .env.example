# Copy to .env.local and fill in. Every value is optional: without them the app
# runs on local device storage with a rule-based assistant.

# Supabase (auth + database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — only used by `npm run db:seed`, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (chat assistant + leaf photo diagnosis)
ANTHROPIC_API_KEY=

# Official AGMARKNET daily mandi-rate feed via data.gov.in.
# Generate a free key at https://data.gov.in → My Account → Generate API Key.
DATA_GOV_API_KEY=
